# --- Azure AI Foundry (recurso Azure OpenAI / Foundry Models) ---
# Endpoint del recurso (portal de Foundry -> Models + endpoints), p. ej. https://mi-recurso.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# Vacío = autenticación Microsoft Entra ID (DefaultAzureCredential: az login / identidad administrada).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Nombres de los DEPLOYMENTS creados en Foundry (no el nombre del modelo)
FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
# false = router por reglas + respuesta por plantilla (reproducible, sin Foundry para el chat)
USE_LLM=true
# foundry | hash (hash = embeddings locales deterministas, solo desarrollo/pruebas)
EMBEDDINGS_PROVIDER=foundry

# --- Azure SQL ---
AZURE_SQL_SERVER=mi-servidor.database.windows.net
AZURE_SQL_DATABASE=andessupply
# entra (DefaultAzureCredential) | sql (usuario y contraseña)
AZURE_SQL_AUTH=entra
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# --- Qdrant ---
# Local: docker run -p 6333:6333 qdrant/qdrant  |  Nube: URL del cluster + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=politicas_andes

# --- Agente ---
# (Los checkpoints del flujo se guardan en Azure SQL, esquema lg: mismo servidor y base que arriba.)
# Número de fallos transitorios simulados en la consulta de fuentes (demo de RetryPolicy)
SIMULAR_FALLOS_FUENTES=0

# --- Observabilidad (opcional, extra "monitor") ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
